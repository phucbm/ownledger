{
  "name": "ownledger",
  "version": "2.0.0",
  "description": "Personal finance ledger used through AI chat (MCP). Your data in your own private GitHub repo, served by your own Cloudflare Worker.",
  "license": "MIT",
  "author": "phucbm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucbm/ownledger.git"
  },
  "homepage": "https://github.com/phucbm/ownledger#readme",
  "keywords": [
    "finance",
    "ledger",
    "mcp",
    "cloudflare-workers",
    "personal-finance"
  ],
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    },
    "./worker": {
      "default": "./dist/worker/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "presets",
    "templates",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/version.mjs && rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/index.js && pnpm build:web",
    "typecheck": "node scripts/version.mjs && tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "fixtures": "tsx scripts/make-fixtures.ts && tsx scripts/make-misa-fixture.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "build:web": "vite build --config web/vite.config.ts && node scripts/web-size.mjs",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "fflate": "0.8.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "recharts": "3.11.0",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wouter": "3.13.0",
    "wrangler": "4.166.0"
  },
  "bin": {
    "ownledger": "./dist/cli/index.js"
  }
}
